# ── Private key material — NEVER commit these ────────────────────────────────
# Your signing key is the root of trust for every GAIA-X credential you issue.
# If it leaks, anyone can impersonate your organisation. Keep it off the repo.
*.p12
*.pfx
*.key
*.pem.key
private-key*.pem
key.pem

# ── Per-deployment artifacts (contain or derive from your real identity) ─────
# These are generated locally during onboarding and are specific to one
# organisation/domain — they should not live in a reusable template.
static/cert.pem
static/.well-known/did.json

# Every signed credential: lrn.jwt, legal-person.jwt, tandc.jwt,
# compliance-vc.jwt. Wildcards so extra credentials added later
# (e.g. gx:ServiceOffering / gx:DataProduct) are covered automatically.
static/gaia-x/*.json
static/gaia-x/*.jwt

# Keep the directory structure and the committed placeholders/examples.
!static/cert.pem.example
!static/.well-known/.gitkeep
!static/gaia-x/.gitkeep
!static/gaia-x/*.example

# ── Caddy / runtime ──────────────────────────────────────────────────────────
caddy_data/
caddy_config/
