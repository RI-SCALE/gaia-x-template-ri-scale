# Copy to .env (git-ignored). Read by docker compose.

# Permanent public domain: did:web:<GX_DOMAIN> and every credential URL derive from it.
GX_DOMAIN=gaia-x.example.eu

# dev = Gaia-X lab ("Playground") dry run; prod = real identity on a production GXDCH.
GX_ENV=dev

# ── Choose your setup ─────────────────────────────────────────────────────────
# Explained in automation/README.md, "Choose your setup". Keep exactly one block active.

# Setup A (default): your organisation's certificate (e.g. from HARICA); its key is kept
# in OpenBao and gx can only ask OpenBao to sign. Caddy serves HTTPS.
COMPOSE_PROFILES=caddy,vault
# ...same, but this host already terminates HTTPS with its own proxy (no Caddy):
# COMPOSE_PROFILES=vault

# Setup B (fallback, no certificate of your own at all): Caddy's Let's Encrypt
# certificate doubles as the identity; no OpenBao. Dev only.
# COMPOSE_PROFILES=caddy
# COMPOSE_FILE=docker-compose.yml:compose.letsencrypt.yml
