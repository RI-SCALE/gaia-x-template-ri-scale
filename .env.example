# Copy to .env (git-ignored). Read by docker compose.

# Permanent public domain: did:web:<GX_DOMAIN> and every credential URL derive from it.
GX_DOMAIN=gaia-x.example.eu

# dev = Gaia-X lab dry run; prod = real identity (needs the Vault signer, not ready yet).
GX_ENV=dev

# Start Caddy (automatic HTTPS) with `docker compose up -d`.
# Remove this line if another reverse proxy already terminates HTTPS for this host.
COMPOSE_PROFILES=caddy
